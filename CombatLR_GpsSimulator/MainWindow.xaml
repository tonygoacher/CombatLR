<Window x:Class="CombatLRGpsSimulator.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="CombatLR GPS Simulator" Width="1200" Height="900"
 Background="#202124">
 <Grid Margin="10">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="190"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <DockPanel Grid.Row="0" Margin="0,0,0,8">
   <StackPanel Orientation="Horizontal">
    <Button Content="Open Map..." Padding="12,6" Margin="0,0,6,0" Click="OpenMap_Click"/>
    <Button Content="Reload" Padding="12,6" Margin="0,0,18,0" Click="Reload_Click"/>
    <TextBlock Text="COM:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
    <ComboBox x:Name="PortCombo" Width="90" Margin="0,0,6,0"/>
    <Button Content="↻" Width="30" Margin="0,0,12,0" Click="RefreshPorts_Click"/>
    <TextBlock Text="Baud:" Foreground="White" VerticalAlignment="Center" Margin="0,0,5,0"/>
    <ComboBox x:Name="BaudCombo" Width="85" SelectedIndex="1" Margin="0,0,12,0">
     <ComboBoxItem Content="4800"/><ComboBoxItem Content="9600"/>
     <ComboBoxItem Content="19200"/><ComboBoxItem Content="38400"/>
     <ComboBoxItem Content="115200"/>
    </ComboBox>
    <Button x:Name="ConnectButton" Content="Connect" Padding="12,6" Click="Connect_Click"/>
   </StackPanel>
  </DockPanel>

        <Border Grid.Row="1"
        Background="#111"
        BorderBrush="#444"
        BorderThickness="1">
            <Viewbox Stretch="Uniform">
                <Grid x:Name="MapHost"
              Background="#111"
              Width="1280"
              Height="960"
              MouseLeftButtonDown="MapHost_MouseLeftButtonDown"
              MouseMove="MapHost_MouseMove"
              MouseLeftButtonUp="MapHost_MouseLeftButtonUp">

                    <Image x:Name="MapImage"
                   Width="1280"
                   Height="960"
                   Stretch="Fill"/>

                    <Canvas x:Name="MarkerCanvas"
                    Width="1280"
                    Height="960"
                    IsHitTestVisible="False">

                        <Line x:Name="HeadingLine"
                      Stroke="White"
                      StrokeThickness="3"
                      X1="11"
                      Y1="11"
                      X2="11"
                      Y2="-18"/>

                        <Ellipse x:Name="GpsMarker"
                         Width="22"
                         Height="22"
                         Fill="#00D084"
                         Stroke="White"
                         StrokeThickness="3"/>
                    </Canvas>
                </Grid>
            </Viewbox>
        </Border>

        <Grid Grid.Row="2" Margin="0,8,0,8">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
   <StackPanel Grid.Column="0" Margin="0,0,10,0">
    <TextBlock Text="NMEA output" Foreground="White" FontSize="14" Margin="0,0,0,4"/>
    <ListBox x:Name="NmeaList" Background="#101010" Foreground="#B9F6CA"
             FontFamily="Consolas" FontSize="12"
             HorizontalContentAlignment="Stretch"/>
   </StackPanel>
   <StackPanel Grid.Column="1">
                <TextBox x:Name="PositionText"
         Text="Position: —"
         Foreground="White"
         Background="#202124"
         BorderThickness="0"
         FontSize="14"
         IsReadOnly="True"
         Padding="0"
         HorizontalScrollBarVisibility="Disabled"/>
                <TextBlock x:Name="MotionText" Text="Speed: 0.0 km/h    Bearing: 0°"
               Foreground="#BFC0C5" Margin="0,4,0,0"/>
    <TextBlock x:Name="StatusText" Text="Load map.bmp and map.json to begin."
               Foreground="#8AB4F8" TextWrapping="Wrap" Margin="0,4,0,10"/>
    <StackPanel Orientation="Horizontal">
     <Button x:Name="StartButton" Content="Start GPS" Padding="14,7" Margin="0,0,6,0" Click="Start_Click"/>
     <Button x:Name="StopButton" Content="Stop" Padding="14,7" Margin="0,0,6,0" Click="Stop_Click"/>
     <Button Content="Clear" Padding="14,7" Click="ClearNmea_Click"/>
    </StackPanel>
    <TextBlock Text="NMEA is displayed here as it is sent." Foreground="#777"
               FontSize="11" Margin="0,8,0,0"/>
   </StackPanel>
  </Grid>

  <StackPanel Grid.Row="3" Orientation="Horizontal">
   <TextBlock Text="Tip: click or drag the green marker on the map to move the simulated GPS position."
              Foreground="#999"/>
  </StackPanel>
 </Grid>
</Window>
