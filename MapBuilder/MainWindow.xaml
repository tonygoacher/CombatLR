<Window x:Class="CombatlrMapBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Combatlr Map Builder - Stage 1"
        Width="1400"
        Height="900"
        MinWidth="900"
        MinHeight="650">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0">
            <Button Content="Open Map Image..."
                    Click="OpenImage_Click"
                    Padding="10,5"/>
            <Separator/>

            <TextBlock Text="Rotation:"
                       VerticalAlignment="Center"
                       Margin="8,0,4,0"/>
            <TextBox x:Name="RotationTextBox"
                     Width="70"
                     Text="0"
                     ToolTip="Map rotation in degrees"
                     TextChanged="SettingsTextBox_TextChanged"/>
            <TextBlock Text="°"
                       VerticalAlignment="Center"
                       Margin="2,0,8,0"/>

            <Separator/>

            <TextBlock Text="Reference distance:"
                       VerticalAlignment="Center"
                       Margin="8,0,4,0"/>
            <TextBox x:Name="DistanceTextBox"
                     Width="90"
                     ToolTip="Real-world distance between reference points, in metres"
                     TextChanged="SettingsTextBox_TextChanged"/>
            <TextBlock Text="m"
                       VerticalAlignment="Center"
                       Margin="2,0,8,0"/>

            <Separator/>

            <Button Content="Clear Reference Points"
                    Click="ClearPoints_Click"
                    Padding="10,5"/>
        </ToolBar>

        <Border Grid.Row="1"
                Margin="10"
                BorderBrush="Gray"
                BorderThickness="1"
                Background="#202020">
            <ScrollViewer x:Name="MapScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="MapScrollViewer_PreviewMouseWheel">
                <Grid x:Name="MapWorkspace"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Image x:Name="MapImage"
                           Stretch="None"
                           MouseLeftButtonDown="MapImage_MouseLeftButtonDown"
                           MouseMove="MapImage_MouseMove"
                           MouseLeftButtonUp="MapImage_MouseLeftButtonUp"/>

                    <Canvas x:Name="OverlayCanvas"
                            IsHitTestVisible="False"/>

                    <Border x:Name="PlayfieldRectangle"
                            Width="1280"
                            Height="960"
                            BorderBrush="LimeGreen"
                            BorderThickness="3"
                            Background="#2000FF00"
                            Visibility="Collapsed"
                            IsHitTestVisible="False">
                        <TextBlock Text="1280 × 960 PLAYFIELD"
                                   Foreground="White"
                                   Background="#AA006000"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Padding="5,2"/>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="ImageStatus"
                           Text="No image loaded"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="PointStatus"
                           Text="Load an image, then click reference point A"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="ScaleStatus"
                           Text="Scale: —"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="PlayfieldStatus"
                           Text="Playfield: —"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
