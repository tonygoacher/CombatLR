<Window x:Class="CombatlrMapBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Combatlr Map Builder"
        Icon="/CombatlrMapBuilder;component/MapBuilder.ico"
        Width="1400"
        Height="900"
        MinWidth="900"
        MinHeight="650">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_File">
                    <MenuItem Header="_New Project"
                              Click="NewProject_Click"/>
                    <MenuItem Header="_Open Project..."
                              Click="OpenProject_Click"/>
                    <MenuItem Header="_Save Project"
                              Click="SaveProject_Click"/>
                    <MenuItem Header="Save Project _As..."
                              Click="SaveProjectAs_Click"/>
                    <Separator/>
                    <MenuItem Header="_Open Source Image..."
                              Click="OpenImage_Click"/>
                    <Separator/>
                    <MenuItem Header="_Export Site Package..."
                              Click="ExportMap_Click"/>
                </MenuItem>
                <MenuItem Header="_Help">
                    <MenuItem Header="_About MapBuilder..."
                              Click="About_Click"/>
                </MenuItem>
            </Menu>

            <ToolBar>
                <Button Content="Open Map Image..."
                        Click="OpenImage_Click"
                        Padding="10,5"/>
                <Separator/>

                <TextBlock Text="A Lat:"
                           VerticalAlignment="Center"
                           Margin="8,0,3,0"/>
                <TextBox x:Name="LatitudeATextBox"
                         Width="82"
                         ToolTip="Latitude of calibration point A"
                         TextChanged="GpsTextBox_TextChanged"/>
                <TextBlock Text="Lon:"
                           VerticalAlignment="Center"
                           Margin="4,0,3,0"/>
                <TextBox x:Name="LongitudeATextBox"
                         Width="90"
                         ToolTip="Longitude of calibration point A"
                         TextChanged="GpsTextBox_TextChanged"/>

                <TextBlock Text="B Lat:"
                           VerticalAlignment="Center"
                           Margin="8,0,3,0"/>
                <TextBox x:Name="LatitudeBTextBox"
                         Width="82"
                         ToolTip="Latitude of calibration point B"
                         TextChanged="GpsTextBox_TextChanged"/>
                <TextBlock Text="Lon:"
                           VerticalAlignment="Center"
                           Margin="4,0,3,0"/>
                <TextBox x:Name="LongitudeBTextBox"
                         Width="90"
                         ToolTip="Longitude of calibration point B"
                         TextChanged="GpsTextBox_TextChanged"/>

                <TextBlock Text="C Lat:"
                           VerticalAlignment="Center"
                           Margin="8,0,3,0"/>
                <TextBox x:Name="LatitudeCTextBox"
                         Width="82"
                         ToolTip="Latitude of calibration point C"
                         TextChanged="GpsTextBox_TextChanged"/>
                <TextBlock Text="Lon:"
                           VerticalAlignment="Center"
                           Margin="4,0,3,0"/>
                <TextBox x:Name="LongitudeCTextBox"
                         Width="90"
                         ToolTip="Longitude of calibration point C"
                         TextChanged="GpsTextBox_TextChanged"/>

                <TextBlock Text="D Lat:"
                           VerticalAlignment="Center"
                           Margin="8,0,3,0"/>
                <TextBox x:Name="LatitudeDTextBox"
                         Width="82"
                         ToolTip="Latitude of calibration point D"
                         TextChanged="GpsTextBox_TextChanged"/>
                <TextBlock Text="Lon:"
                           VerticalAlignment="Center"
                           Margin="4,0,3,0"/>
                <TextBox x:Name="LongitudeDTextBox"
                         Width="90"
                         ToolTip="Longitude of calibration point D"
                         TextChanged="GpsTextBox_TextChanged"/>

                <TextBlock Text="A→B:"
                           VerticalAlignment="Center"
                           Margin="8,0,3,0"/>
                <TextBlock x:Name="DistanceDisplay"
                           Text="—"
                           VerticalAlignment="Center"
                           MinWidth="75"/>

                <Separator/>

                <Button Content="Clear Calibration Points"
                        Click="ClearPoints_Click"
                        Padding="10,5"/>

                <Separator/>

                <Button Content="Export Site Package..."
                        Click="ExportMap_Click"
                        Padding="10,5"/>

                <Separator/>

                <TextBlock Text="Zoom:"
                           VerticalAlignment="Center"
                           Margin="8,0,4,0"/>
                <TextBlock x:Name="ZoomStatus"
                           Text="100%"
                           VerticalAlignment="Center"/>
            </ToolBar>
        </DockPanel>

        <Border Grid.Row="1"
                Margin="10"
                BorderBrush="Gray"
                BorderThickness="1"
                Background="#202020">
            <ScrollViewer x:Name="MapScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="MapScrollViewer_PreviewMouseWheel">
                <!--
                    MapWorkspace is the complete source image. Its
                    LayoutTransform scales the entire workspace, so the
                    ScrollViewer extent follows the whole zoomed image.
                    The image itself is NOT given an explicit Width/Height:
                    WPF therefore renders the complete bitmap at its natural
                    pixel dimensions instead of putting it into a smaller
                    containing rectangle which can clip it.
                -->
                <Canvas x:Name="MapWorkspace"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <Canvas.LayoutTransform>
                        <ScaleTransform x:Name="MapScaleTransform"
                                        ScaleX="1"
                                        ScaleY="1"/>
                    </Canvas.LayoutTransform>

                    <Image x:Name="MapImage"
                           Stretch="None"
                           MouseLeftButtonDown="MapImage_MouseLeftButtonDown"/>

                    <Canvas x:Name="OverlayCanvas"
                            IsHitTestVisible="False"/>

                    <Border x:Name="PlayfieldRectangle"
                            Width="1280"
                            Height="960"
                            BorderBrush="LimeGreen"
                            BorderThickness="3"
                            Background="#2000FF00"
                            MouseLeftButtonDown="Playfield_MouseLeftButtonDown"
                            MouseMove="Playfield_MouseMove"
                            MouseLeftButtonUp="Playfield_MouseLeftButtonUp"
                            MouseRightButtonDown="Playfield_MouseRightButtonDown"
                            MouseRightButtonUp="Playfield_MouseRightButtonUp">
                        <Grid>
                            <TextBlock Text="PLAYFIELD"
                                       Foreground="White"
                                       Background="#AA006000"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Padding="5,2"/>

                            <Thumb x:Name="TopLeftHandle"
                                   Width="14" Height="14"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Cursor="SizeNWSE"
                                   DragStarted="ResizeHandle_DragStarted"
                                   DragDelta="ResizeHandle_DragDelta"
                                   DragCompleted="ResizeHandle_DragCompleted"/>

                            <Thumb x:Name="BottomRightHandle"
                                   Width="14" Height="14"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   Cursor="SizeNWSE"
                                   DragStarted="ResizeHandle_DragStarted"
                                   DragDelta="ResizeHandle_DragDelta"
                                   DragCompleted="ResizeHandle_DragCompleted"/>
                        </Grid>
                    </Border>
                </Canvas>
            </ScrollViewer>
        </Border>

        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="ImageStatus"
                           Text="No image loaded"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="PointStatus"
                           Text="Load an image, then click reference point A"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="ScaleStatus"
                           Text="Scale: —"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="GpsStatus"
                           Text="GPS: —"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="TransformStatus"
                           Text="Transform: —"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="PlayfieldStatus"
                           Text="Playfield: —"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
