<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CombatLR.mobile.Pages.GameControlPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Game Control">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label
                Text="GAME CONTROL"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <HorizontalStackLayout Spacing="12">
                <Button
                    x:Name="DiscoverButton"
                    Text="DISCOVER"
                    Clicked="DiscoverButton_Clicked"
                    HorizontalOptions="FillAndExpand" />

                <ActivityIndicator
                    x:Name="DiscoveryActivity"
                    IsVisible="False"
                    IsRunning="False"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label
                Text="COMBATLR DEVICES"
                FontSize="18"
                FontAttributes="Bold" />

            <CollectionView
                x:Name="DevicesView"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label
                        Text="Waiting for CombatLR devices..."
                        HorizontalOptions="Center"
                        Margin="0,30" />
                </CollectionView.EmptyView>

                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        Orientation="Vertical"
                        Span="2"
                        HorizontalItemSpacing="8"
                        VerticalItemSpacing="8" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="10"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{Binding TeamBackgroundColor}">

                            <Grid
                                RowDefinitions="Auto,Auto,Auto"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="8"
                                RowSpacing="5">

                                <!-- MAC -->
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding DeviceId}"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    TextColor="{Binding TeamTextColor}"
                                    LineBreakMode="NoWrap" />

                                <!-- IP / State -->
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="{Binding IpAddress}"
                                    FontSize="13"
                                    TextColor="{Binding TeamTextColor}"
                                    LineBreakMode="NoWrap" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding State}"
                                    FontSize="13"
                                    TextColor="{Binding TeamTextColor}"
                                    HorizontalTextAlignment="End"
                                    LineBreakMode="NoWrap" />

                                <!-- Controls -->
                                <HorizontalStackLayout
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Spacing="6">

                                    <Label
                                        Text="ID:"
                                        VerticalOptions="Center"
                                        TextColor="{Binding TeamTextColor}" />

                                    <Entry
                                        WidthRequest="55"
                                        HeightRequest="40"
                                        Keyboard="Numeric"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding PlayerId, Mode=OneWay}"
                                        BackgroundColor="{Binding PlayerIdBackgroundColor}"
                                        TextColor="{Binding PlayerIdTextColor}"
                                        Completed="PlayerIdEntry_Completed" />

                                    <Picker
                                        WidthRequest="90"
                                        HeightRequest="40"
                                        Title="Team"
                                        TextColor="{Binding TeamTextColor}"
                                        SelectedItem="{Binding TeamName, Mode=OneWay}"
                                        SelectedIndexChanged="TeamPicker_SelectedIndexChanged">

                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>Red</x:String>
                                                <x:String>Blue</x:String>
                                                <x:String>Yellow</x:String>
                                                <x:String>Green</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>

                                    </Picker>

                                </HorizontalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
