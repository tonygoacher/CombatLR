<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CombatLR.mobile.Pages.GameControlPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Game Control">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="GAME CONTROL"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <HorizontalStackLayout Spacing="12">
                <Button
                    x:Name="DiscoverButton"
                    Text="DISCOVER"
                    Clicked="DiscoverButton_Clicked"
                    HorizontalOptions="FillAndExpand" />

                <ActivityIndicator
                    x:Name="DiscoveryActivity"
                    IsVisible="False"
                    IsRunning="False"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label
                Text="COMBATLR DEVICES"
                FontSize="18"
                FontAttributes="Bold" />

            <CollectionView
                x:Name="DevicesView"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label
                        Text="Waiting for CombatLR devices..."
                        HorizontalOptions="Center"
                        Margin="0,30" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="14"
                            Margin="0,0,0,10"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{Binding TeamBackgroundColor}">

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">

                                <!-- Controls and state -->
                                <VerticalStackLayout
                                    Grid.Column="0"
                                    Spacing="8">

                                    <Label
                                        Text="{Binding State}"
                                        TextColor="{Binding TeamTextColor}" />

                                    <HorizontalStackLayout Spacing="8">
                                        <Label
                                            Text="Player ID:"
                                            VerticalOptions="Center"
                                            TextColor="{Binding TeamTextColor}" />

                                        <Entry
                                            WidthRequest="70"
                                            Keyboard="Numeric"
                                            HorizontalTextAlignment="Center"
                                            Text="{Binding PlayerId, Mode=OneWay}"
                                            BackgroundColor="{Binding PlayerIdBackgroundColor}"
                                            TextColor="{Binding PlayerIdTextColor}"
                                            Completed="PlayerIdEntry_Completed" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="8">
                                        <Label
                                            Text="Team:"
                                            VerticalOptions="Center"
                                            TextColor="{Binding TeamTextColor}" />

                                        <Picker
                                            WidthRequest="110"
                                            Title="Team"
                                            TextColor="{Binding TeamTextColor}"
                                            SelectedItem="{Binding TeamName, Mode=OneWay}"
                                            SelectedIndexChanged="TeamPicker_SelectedIndexChanged">

                                            <Picker.ItemsSource>
                                                <x:Array Type="{x:Type x:String}">
                                                    <x:String>Red</x:String>
                                                    <x:String>Blue</x:String>
                                                    <x:String>Yellow</x:String>
                                                    <x:String>Green</x:String>
                                                </x:Array>
                                            </Picker.ItemsSource>

                                        </Picker>
                                    </HorizontalStackLayout>

                                </VerticalStackLayout>

                                <!-- Network information -->
                                <VerticalStackLayout
                                    Grid.Column="1"
                                    Spacing="4"
                                    VerticalOptions="Start"
                                    HorizontalOptions="End">

                                    <Label
                                        Text="{Binding DeviceId}"
                                        FontSize="17"
                                        FontAttributes="Bold"
                                        TextColor="{Binding TeamTextColor}"
                                        HorizontalTextAlignment="End" />

                                    <Label
                                        Text="{Binding IpAddress}"
                                        TextColor="{Binding TeamTextColor}"
                                        HorizontalTextAlignment="End" />

                                </VerticalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
