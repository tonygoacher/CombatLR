<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="CombatLR.mobile.Pages.GameControlPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Game Control">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label
                Text="GAME CONTROL"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">

                <Button
                    x:Name="DiscoverButton"
                    Grid.Column="0"
                    Text="DISCOVER"
                    Clicked="DiscoverButton_Clicked" />

                <Button
                    x:Name="FriendlyFireOnButton"
                    Grid.Column="1"
                    Text="FRIENDLY FIRE ON"
                    Clicked="FriendlyFireOnButton_Clicked"
                    IsEnabled="False" />

                <Button
                    x:Name="FriendlyFireOffButton"
                    Grid.Column="2"
                    Text="FRIENDLY FIRE OFF"
                    Clicked="FriendlyFireOffButton_Clicked"
                    IsEnabled="False" />

                <Button
                    x:Name="StartGameButton"
                    Grid.Column="3"
                    Text="START GAME"
                    Clicked="StartGameButton_Clicked"
                    IsEnabled="False" />

            </Grid>

            <Grid
                ColumnDefinitions="*,Auto"
                ColumnSpacing="10">

                <Label
                    x:Name="GameStartLabel"
                    Grid.Column="0"
                    Text="GAME START: Not set"
                    FontSize="16"
                    FontAttributes="Bold"
                    VerticalOptions="Center" />

                <Button
                    x:Name="LateStartButton"
                    Grid.Column="1"
                    Text="LATE START"
                    Clicked="LateStartButton_Clicked"
                    IsEnabled="False" />

            </Grid>

            <ActivityIndicator
                x:Name="DiscoveryActivity"
                IsVisible="False"
                IsRunning="False"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <Label
                Text="COMBATLR DEVICES"
                FontSize="18"
                FontAttributes="Bold" />

            <CollectionView
                x:Name="DevicesView"
                SelectionMode="None">

                <CollectionView.EmptyView>
                    <Label
                        Text="Waiting for CombatLR devices..."
                        HorizontalOptions="Center"
                        Margin="0,30" />
                </CollectionView.EmptyView>

                <CollectionView.ItemsLayout>
                    <GridItemsLayout
                        Orientation="Vertical"
                        Span="2"
                        HorizontalItemSpacing="8"
                        VerticalItemSpacing="8" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="10"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            BackgroundColor="{Binding TeamBackgroundColor}">

                            <Grid
                                RowDefinitions="Auto,Auto,Auto,Auto"
                                ColumnDefinitions="*,Auto"
                                ColumnSpacing="8"
                                RowSpacing="5">

                                <!-- MAC -->
                                <Label
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding DeviceId}"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    TextColor="{Binding TeamTextColor}"
                                    LineBreakMode="NoWrap" />

                                <!-- IP / State -->
                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="{Binding IpAddress}"
                                    FontSize="13"
                                    TextColor="{Binding TeamTextColor}"
                                    LineBreakMode="NoWrap" />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding DisplayState}"
                                    FontSize="13"
                                    TextColor="{Binding TeamTextColor}"
                                    HorizontalTextAlignment="End"
                                    LineBreakMode="NoWrap" />

                                <!-- Game Plan -->
                                <Grid
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    ColumnDefinitions="Auto,*,Auto"
                                    ColumnSpacing="6">

                                    <Label
                                        Grid.Column="0"
                                        Text="Plan:"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{Binding TeamTextColor}" />

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding PlanName}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{Binding TeamTextColor}"
                                        LineBreakMode="TailTruncation" />

                                    <Label
                                        Grid.Column="2"
                                        Text="{Binding PlanVersion, StringFormat='v{0}'}"
                                        FontSize="14"
                                        FontAttributes="Bold"
                                        TextColor="{Binding TeamTextColor}"
                                        HorizontalTextAlignment="End" />
                                </Grid>

                                <!-- Controls -->
                                <HorizontalStackLayout
                                    Grid.Row="3"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Spacing="6">

                                    <Image
                                        Source="{Binding FriendlyFireIcon}"
                                        WidthRequest="48"
                                        HeightRequest="48"
                                        Aspect="AspectFit"
                                        VerticalOptions="Center"
                                        IsEnabled="{Binding FriendlyFireButtonEnabled}"
                                        Opacity="{Binding FriendlyFireButtonOpacity}"
                                        SemanticProperties.Description="Friendly fire status">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Tapped="FriendlyFireIcon_Tapped" />
                                        </Image.GestureRecognizers>
                                    </Image>

                                    <Label
                                        Text="ID:"
                                        VerticalOptions="Center"
                                        TextColor="{Binding TeamTextColor}" />

                                    <Entry
                                        WidthRequest="55"
                                        HeightRequest="40"
                                        Keyboard="Numeric"
                                        HorizontalTextAlignment="Center"
                                        Text="{Binding PlayerId, Mode=OneWay}"
                                        BackgroundColor="{Binding PlayerIdBackgroundColor}"
                                        TextColor="{Binding PlayerIdTextColor}"
                                        Completed="PlayerIdEntry_Completed" />

                                    <Picker
                                        WidthRequest="90"
                                        HeightRequest="40"
                                        Title="Team"
                                        TextColor="{Binding TeamTextColor}"
                                        SelectedItem="{Binding TeamName, Mode=OneWay}"
                                        SelectedIndexChanged="TeamPicker_SelectedIndexChanged">

                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>Red</x:String>
                                                <x:String>Blue</x:String>
                                                <x:String>Yellow</x:String>
                                                <x:String>Green</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>

                                    </Picker>

                                </HorizontalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
