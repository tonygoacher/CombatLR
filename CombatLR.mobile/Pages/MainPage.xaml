<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CombatLR.mobile.Pages.MainPage"
    BackgroundColor="Black">

    <Grid>
        <Grid
            x:Name="MapContainer"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">


            <Image
                x:Name="MapImage"
                Aspect="AspectFit"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                InputTransparent="True" />

            <Grid
                x:Name="MapVisualLayer"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                InputTransparent="True">

                <Label
                x:Name="HomeMarker"
                Text="⌂"
                FontSize="32"
                TextColor="Red"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                IsVisible="False" />    

            </Grid>

            <BoxView
                x:Name="MapTouchView"
                BackgroundColor="Transparent"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                InputTransparent="True" />

        </Grid>

        <Border
            HorizontalOptions="Start"
            VerticalOptions="Start"
            Margin="10"
            Padding="10"
            BackgroundColor="Black"
            Stroke="White"
            StrokeThickness="2"
            ZIndex="10">

            <Label
             x:Name="MapInfoLabel"
             Text="Starting..."
             TextColor="White"
             FontSize="14">

                <Label.GestureRecognizers>
                    <TapGestureRecognizer
            Tapped="MapInfoLabel_Tapped" />
                </Label.GestureRecognizers>

            </Label>

        </Border>

        <HorizontalStackLayout
    HorizontalOptions="Center"
    VerticalOptions="End"
    Margin="0,0,0,20"
    Spacing="10"
    ZIndex="20">

            <Button
        Text="New"
        Clicked="NewGamePlan_Clicked" />

            <Button
        Text="Save"
        Clicked="SaveGamePlan_Clicked" />

            <Button
        Text="Load"
        Clicked="LoadGamePlan_Clicked" />

            <Button
        Text="Set Home"
        Clicked="SetHome_Clicked" />    

        </HorizontalStackLayout>

    </Grid>

</ContentPage>