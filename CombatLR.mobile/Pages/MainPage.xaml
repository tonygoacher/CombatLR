<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CombatLR.mobile.Pages.MainPage"
    BackgroundColor="Black">

    <Grid>
        <Grid
            x:Name="MapContainer"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">


            <Image
                x:Name="MapImage"
                Aspect="AspectFit"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                InputTransparent="True" />

            <Grid
                x:Name="MapVisualLayer"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                InputTransparent="True">

                <Grid
    x:Name="HomeMarker"
    WidthRequest="36"
    HeightRequest="36"
    HorizontalOptions="Start"
    VerticalOptions="Start"
    IsVisible="False"
    InputTransparent="True">

                    <Label
        Text="⌂"
        FontSize="32"
        TextColor="Red"
        HorizontalOptions="Center"
        VerticalOptions="Center" />

                    <Label
        Text="+"
        FontSize="16"
        FontAttributes="Bold"
        TextColor="White"
        HorizontalOptions="Center"
        VerticalOptions="Center" />

                </Grid>
            </Grid>

            <BoxView
                x:Name="MapTouchView"
                BackgroundColor="Transparent"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                InputTransparent="True" />

        </Grid>

        <Border
            HorizontalOptions="Start"
            VerticalOptions="Start"
            Margin="10"
            Padding="10"
            BackgroundColor="Black"
            Stroke="White"
            StrokeThickness="2"
            ZIndex="10">

            <Label
             x:Name="MapInfoLabel"
             Text="Starting..."
             TextColor="White"
             FontSize="14">

                <Label.GestureRecognizers>
                    <TapGestureRecognizer
            Tapped="MapInfoLabel_Tapped" />
                </Label.GestureRecognizers>

            </Label>

        </Border>

        <HorizontalStackLayout
    HorizontalOptions="Center"
    VerticalOptions="End"
    Margin="0,0,0,20"
    Spacing="10"
    ZIndex="20">

            <Button
                x:Name="NewButton"
                Text="New"
                Clicked="NewGamePlan_Clicked" />        

            <Button
                x:Name="SaveButton"
                Text="Save"
                Clicked="SaveGamePlan_Clicked" />

            <Button
                x:Name="LoadButton"
                Text="Load"
                Clicked="LoadGamePlan_Clicked" />       

            <Button
                x:Name="SetHomeButton"
                Text="Set Home"
                Clicked="SetHome_Clicked" />

            <Button
                x:Name="CoordinateModeButton"
                Text="Position: TAP"
                Clicked="CoordinateMode_Clicked" />


            <Button
    x:Name="AddZoneButton"
    Text="Add Zone"
    Clicked="AddZone_Clicked" />

            <Button
    x:Name="PreviousZoneButton"
    Text="◀ Zone"
    Clicked="PreviousZone_Clicked" />

            <Button
    x:Name="NextZoneButton"
    Text="Zone ▶"
    Clicked="NextZone_Clicked" />

            <Button
    x:Name="MoveZoneButton"
    Text="Move Zone"
    Clicked="MoveZone_Clicked" />

            <Button
    x:Name="ShowAllZonesButton"
    Text="All Zones"
    Clicked="ShowAllZones_Clicked" />

        </HorizontalStackLayout>

    </Grid>

</ContentPage>