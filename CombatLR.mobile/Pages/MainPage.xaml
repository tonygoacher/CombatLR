<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CombatLR.mobile.Pages.MainPage"
    BackgroundColor="Black"
    NavigationPage.HasNavigationBar="False">

    <Grid
        Padding="24"
        RowDefinitions="Auto,*,Auto">

        <VerticalStackLayout
            Grid.Row="0"
            Spacing="4"
            HorizontalOptions="Center"
            Margin="0,30,0,0">

            <Label
                Text="CombatLR"
                TextColor="White"
                FontSize="36"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />

            <Label
                Text="Combat control"
                TextColor="LightGray"
                FontSize="16"
                HorizontalTextAlignment="Center" />

            <Label
                x:Name="SelectedGamePlanLabel"
                Text="No game plan selected"
                TextColor="LightGray"
                FontSize="13"
                HorizontalTextAlignment="Center" />

        </VerticalStackLayout>

        <VerticalStackLayout
            Grid.Row="1"
            Spacing="20"
            VerticalOptions="Center"
            HorizontalOptions="Center"
            WidthRequest="280">

            <Button
                Text="GAME PLAN EDITOR"
                FontSize="20"
                HeightRequest="70"
                Clicked="GamePlanEditor_Clicked" />

            <Button
                Text="GAME CONTROL"
                FontSize="20"
                HeightRequest="70"
                Clicked="GameControl_Clicked" />

            <Button
                x:Name="GameProgressButton"
                Text="GAME PROGRESS"
                FontSize="20"
                HeightRequest="70"
                IsEnabled="False"
                Clicked="GameProgress_Clicked" />

            <Button
                Text="PROJECT UPDATE"
                FontSize="20"
                HeightRequest="70"
                Clicked="ProjectUpdate_Clicked" />

        </VerticalStackLayout>

        <Label
            Grid.Row="2"
            Text="CombatLR"
            TextColor="Gray"
            FontSize="12"
            HorizontalTextAlignment="Center"
            Margin="0,0,0,10" />

    </Grid>

</ContentPage>
