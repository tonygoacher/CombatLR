<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CombatLR.mobile.Pages.ZoneEditPage"
    BackgroundColor="#CC000000">

    <Grid
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Padding="20">

        <Border
            BackgroundColor="Black"
            Stroke="White"
            StrokeThickness="2"
            Padding="20"
            WidthRequest="360">

            <VerticalStackLayout
                Spacing="12">

                <Label
                    x:Name="TitleLabel"
                    Text="Edit Zone"
                    TextColor="White"
                    FontSize="22"
                    FontAttributes="Bold"
                    HorizontalOptions="Center" />

                <Grid
                    ColumnDefinitions="*,Auto"
                    RowDefinitions="Auto,Auto,Auto"
                    RowSpacing="10">

                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Radius:"
                        TextColor="White"
                        VerticalTextAlignment="Center" />

                    <HorizontalStackLayout
                        Grid.Row="0"
                        Grid.Column="1"
                        Spacing="4">

                        <Entry
                            x:Name="RadiusEntry"
                            WidthRequest="90"
                            Keyboard="Numeric"
                            TextColor="White"
                            HorizontalTextAlignment="End" />

                        <Label
                            Text="m"
                            TextColor="White"
                            VerticalTextAlignment="Center" />

                    </HorizontalStackLayout>

                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="Start time:"
                        TextColor="White"
                        VerticalTextAlignment="Center" />

                    <Entry
                        x:Name="StartTimeEntry"
                        Grid.Row="1"
                        Grid.Column="1"
                        WidthRequest="90"
                        Placeholder="0"
                        Keyboard="Numeric"
                        TextColor="White"
                        HorizontalTextAlignment="End" />

                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        Text="Lifespan:"
                        TextColor="White"
                        VerticalTextAlignment="Center" />

                    <Entry
                        x:Name="LifespanEntry"
                        Grid.Row="2"
                        Grid.Column="1"
                        WidthRequest="90"
                        Placeholder="0"
                        Keyboard="Numeric"
                        TextColor="White"
                        HorizontalTextAlignment="End" />

                </Grid>

                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="12"
                    Margin="0,10,0,0">

                    <Button
                        Text="Cancel"
                        Clicked="Cancel_Clicked" />

                    <Button
                        Text="OK"
                        Clicked="Ok_Clicked" />

                </HorizontalStackLayout>

            </VerticalStackLayout>

        </Border>

    </Grid>

</ContentPage>