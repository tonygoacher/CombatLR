<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CombatLR.mobile.Pages.ZoneEditPage"
    BackgroundColor="#CC000000">

    <Grid
        HorizontalOptions="Center"
        VerticalOptions="Center"
        Padding="20">

        <Border
            BackgroundColor="Black"
            Stroke="White"
            StrokeThickness="2"
            Padding="20"
            WidthRequest="360">

            <VerticalStackLayout
                Spacing="12">

                <Label
                    x:Name="TitleLabel"
                    Text="Edit Zone"
                    TextColor="White"
                    FontSize="22"
                    FontAttributes="Bold"
                    HorizontalOptions="Center" />

                <!-- Large duplicate of the active numeric value, kept near the top
                     of the dialog so it remains visible above the Android keypad. -->
                <Border
                    BackgroundColor="#263542"
                    Stroke="#78B7E8"
                    StrokeThickness="1"
                    Padding="10">
                    <VerticalStackLayout Spacing="2">
                        <Label
                            x:Name="ActiveValueCaption"
                            Text="Current value"
                            TextColor="#D0D8E0"
                            FontSize="12"
                            HorizontalTextAlignment="Center" />
                        <Label
                            x:Name="ActiveValueLabel"
                            Text="—"
                            TextColor="White"
                            FontSize="28"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Grid
                    ColumnDefinitions="*,Auto"
                    RowDefinitions="Auto,Auto,Auto"
                    RowSpacing="10">

                    <Label
                        Grid.Row="0"
                        Grid.Column="0"
                        Text="Radius:"
                        TextColor="White"
                        VerticalTextAlignment="Center" />

                    <HorizontalStackLayout
                        Grid.Row="0"
                        Grid.Column="1"
                        Spacing="4">

                        <Entry
                            x:Name="RadiusEntry"
                            AutomationId="RadiusEntry"
                            WidthRequest="90"
                            Keyboard="Numeric"
                            TextColor="White"
                            HorizontalTextAlignment="End"
                            TextChanged="NumericEntry_TextChanged"
                            Focused="NumericEntry_Focused" />

                        <Label
                            Text="m"
                            TextColor="White"
                            VerticalTextAlignment="Center" />

                    </HorizontalStackLayout>

                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="Start time:"
                        TextColor="White"
                        VerticalTextAlignment="Center" />

                    <HorizontalStackLayout
                        Grid.Row="1"
                        Grid.Column="1"
                        Spacing="4">
                        <Entry
                            x:Name="StartTimeEntry"
                            AutomationId="StartTimeEntry"
                            WidthRequest="90"
                            Placeholder="0"
                            Keyboard="Numeric"
                            TextColor="White"
                            HorizontalTextAlignment="End"
                            TextChanged="NumericEntry_TextChanged"
                            Focused="NumericEntry_Focused" />
                        <Label
                            Text="min"
                            TextColor="White"
                            VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>

                    <Label
                        Grid.Row="2"
                        Grid.Column="0"
                        Text="Lifespan:"
                        TextColor="White"
                        VerticalTextAlignment="Center" />

                    <HorizontalStackLayout
                        Grid.Row="2"
                        Grid.Column="1"
                        Spacing="4">
                        <Entry
                            x:Name="LifespanEntry"
                            AutomationId="LifespanEntry"
                            WidthRequest="90"
                            Placeholder="0"
                            Keyboard="Numeric"
                            TextColor="White"
                            HorizontalTextAlignment="End"
                            TextChanged="NumericEntry_TextChanged"
                            Focused="NumericEntry_Focused" />
                        <Label
                            Text="min"
                            TextColor="White"
                            VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>

                </Grid>

                <HorizontalStackLayout
                    HorizontalOptions="Center"
                    Spacing="12"
                    Margin="0,10,0,0">

                    <Button
                        Text="Cancel"
                        Clicked="Cancel_Clicked" />

                    <Button
                        Text="OK"
                        Clicked="Ok_Clicked" />

                </HorizontalStackLayout>

            </VerticalStackLayout>

        </Border>

    </Grid>

</ContentPage>